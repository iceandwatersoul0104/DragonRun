<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="?attr/text"
            android:textSize="28sp" />
        <com.acooldog.fuckrun.ui.DragonLogoView
            android:layout_width="56dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="步频模拟"
            android:textColor="?attr/text"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="16dp">

                <Switch
                    android:id="@+id/switch_cadence"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="启用步频接管"
                    android:textColor="?attr/text"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="接管计步器 / 加速度计事件，向目标进程注入固定步频的传感器波形。"
                    android:textColor="?attr/text_sub"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="最低步频 172 步/分"
                    android:textColor="?attr/text"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/seek_min"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="80"
                    android:progress="32" />

                <TextView
                    android:id="@+id/tv_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="最高步频 182 步/分"
                    android:textColor="?attr/text"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/seek_max"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="80"
                    android:progress="42" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_float"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:text="显示悬浮开关" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:text="悬浮开关可拖拽；点按切换步频开关。步频与路线模拟可同时运行。"
                android:textColor="?attr/text_sub"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
