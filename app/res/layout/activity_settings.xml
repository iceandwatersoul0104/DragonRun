<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="?attr/text"
            android:textSize="28sp" />
        <com.acooldog.fuckrun.ui.DragonLogoView
            android:layout_width="56dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="设置与自检"
            android:textColor="?attr/text"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="外观样式" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tv_theme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="当前：蓝白"
                    android:textColor="?attr/text"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <Button
                        android:id="@+id/btn_theme_blue"
                        style="@style/GhostButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="蓝白 · 蓝龙" />

                    <Button
                        android:id="@+id/btn_theme_red"
                        style="@style/GhostButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="红黑 · 红龙" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="切换后立即生效：蓝白为蓝色龙焰，红黑为红色龙焰；选择会保存。"
                    android:textColor="?attr/text_sub"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="模块状态" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="尚未连接目标进程"
                    android:textColor="?attr/text"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_lsposed"
                    style="@style/GhostButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="打开 LSPosed 管理器" />

                <Button
                    android:id="@+id/btn_target"
                    style="@style/PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:text="打开步道乐跑" />
            </LinearLayout>

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="反检测" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginTop="8dp">

                <Switch
                    android:id="@+id/sw_root"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:checked="true"
                    android:text="隐藏 root / Magisk / Xposed 痕迹"
                    android:textColor="?attr/text"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/sw_mock"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:checked="true"
                    android:text="抹除模拟定位标记"
                    android:textColor="?attr/text"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/sw_log"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="静默模块日志"
                    android:textColor="?attr/text"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="广告与界面" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginTop="8dp">

                <Switch
                    android:id="@+id/sw_adblock"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:checked="true"
                    android:text="去除步道乐跑广告（开屏 / 信息流 / 激励视频）"
                    android:textColor="?attr/text"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="10dp"
                    android:text="重启步道乐跑后生效；若某页面加载异常可关闭此项"
                    android:textColor="?attr/text_sub"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="定位信号参数" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="卫星数（1-12）"
                        android:textColor="?attr/text"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/et_satellites"
                        android:layout_width="78dp"
                        android:layout_height="40dp"
                        android:background="@drawable/input_bg"
                        android:gravity="center"
                        android:inputType="number"
                        android:text="9"
                        android:textColor="?attr/text"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="HDOP（0.5-3.0）"
                        android:textColor="?attr/text"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/et_hdop"
                        android:layout_width="78dp"
                        android:layout_height="40dp"
                        android:background="@drawable/input_bg"
                        android:gravity="center"
                        android:inputType="numberDecimal"
                        android:text="1.5"
                        android:textColor="?attr/text"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="精度（米）"
                        android:textColor="?attr/text"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/et_accuracy"
                        android:layout_width="78dp"
                        android:layout_height="40dp"
                        android:background="@drawable/input_bg"
                        android:gravity="center"
                        android:inputType="numberDecimal"
                        android:text="3.0"
                        android:textColor="?attr/text"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_save_params"
                    style="@style/PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:text="保存参数" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="20dp"
                android:paddingBottom="24dp"
                android:text="本应用仅用于学习与自用测试。启用 LSPosed 模块后，请把作用域勾选为「步道乐跑 com.lptiyu.tanke」。"
                android:textColor="?attr/text_sub"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
