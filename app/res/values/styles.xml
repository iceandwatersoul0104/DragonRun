<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">?attr/primary</item>
        <item name="android:colorPrimaryDark">?attr/primary_dark</item>
        <item name="android:colorAccent">?attr/primary</item>
        <item name="android:windowBackground">?attr/bg</item>
        <item name="android:statusBarColor">?attr/primary_dark</item>
        <item name="android:navigationBarColor">?attr/card</item>
        <item name="android:textColorPrimary">?attr/text</item>
        <item name="android:textColorSecondary">?attr/text_sub</item>

        <item name="bg">@color/blue_bg</item>
        <item name="card">@color/blue_card</item>
        <item name="primary">@color/blue_primary</item>
        <item name="primary_dark">@color/blue_primary_dark</item>
        <item name="text">@color/blue_text</item>
        <item name="text_sub">@color/blue_text_sub</item>
        <item name="green">@color/blue_green</item>
        <item name="red">@color/blue_red</item>
        <item name="line">@color/blue_line</item>
        <item name="chip_bg">@color/blue_chip_bg</item>
        <item name="on_primary">@color/on_primary</item>
    </style>

    <style name="AppTheme.Red">
        <item name="android:colorPrimary">?attr/primary</item>
        <item name="android:colorPrimaryDark">?attr/primary_dark</item>
        <item name="android:colorAccent">?attr/primary</item>
        <item name="android:windowBackground">?attr/bg</item>
        <item name="android:statusBarColor">?attr/primary_dark</item>
        <item name="android:navigationBarColor">?attr/card</item>
        <item name="android:textColorPrimary">?attr/text</item>
        <item name="android:textColorSecondary">?attr/text_sub</item>

        <item name="bg">@color/red_bg</item>
        <item name="card">@color/red_card</item>
        <item name="primary">@color/red_primary</item>
        <item name="primary_dark">@color/red_primary_dark</item>
        <item name="text">@color/red_text</item>
        <item name="text_sub">@color/red_text_sub</item>
        <item name="green">@color/red_green</item>
        <item name="red">@color/red_red</item>
        <item name="line">@color/red_line</item>
        <item name="chip_bg">@color/red_chip_bg</item>
        <item name="on_primary">@color/on_primary</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/text_sub</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="PrimaryButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">?attr/on_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="GhostButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">?attr/primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="DangerButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/btn_danger</item>
        <item name="android:textColor">?attr/on_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
